<view class="screen">
  <button class="screen-back" bindtap="onBack">‹ 返回</button>
  <view class="draw-heading"><text class="draw-title">{{mode === 'duo' ? '你先画，让 TA 猜' : '今天，就画它'}}</text><text class="round-badge">{{mode === 'duo' ? '双人 · 画画回合' : '单人 · 自在画'}}</text></view>
  <view class="reference"><block wx:if="{{referenceVisible}}"><image wx:if="{{meal.imageUrl}}" src="{{meal.imageUrl}}" mode="aspectFit" binderror="onImageError"/><view wx:else class="image-placeholder compact">暂无参考图</view><view><text class="reference-name">{{meal.name}}</text><text class="reference-desc">{{meal.imageUrl ? '对照餐品画，也可以画眼前的实物' : '暂无参考图，可对照实物画'}}</text></view></block><view wx:else><text class="reference-name">参考图已收起</text><text class="reference-desc">跟着自己的感觉画</text></view><button bindtap="onReference">{{referenceVisible ? '收起参考' : '展开参考'}}</button></view>
  <view class="canvas-paper"><canvas type="2d" id="drawCanvas" class="canvas" bindtouchstart="onTouchStart" catchtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd" disable-scroll="{{true}}"/><view wx:if="{{!hasInk}}" class="canvas-placeholder"><text class="placeholder-pencil">✎</text><text class="placeholder-title">在这里，画今天的{{meal.name}}</text><text class="placeholder-desc">歪歪扭扭，也很可爱。</text></view><text class="canvas-counter">YOUR LITTLE MASTERPIECE</text></view>
  <view class="tools"><view class="swatches"><button wx:for="{{colors}}" wx:key="*this" class="swatch {{color === item &amp;&amp; !erase ? 'active' : ''}}" style="background:{{item}}" data-color="{{item}}" bindtap="onColor" aria-label="画笔颜色{{item}}"/></view><button class="tool-button {{erase ? 'active' : ''}}" bindtap="onEraser">▱ 橡皮</button></view>
  <view class="tool-row"><view class="brush-sizes"><button wx:for="{{sizes}}" wx:key="*this" class="brush-size {{brush === item ? 'active' : ''}}" data-size="{{item}}" bindtap="onSize" aria-label="画笔粗细{{index + 1}}"><view class="brush-dot" style="width:{{8 + index * 6}}rpx;height:{{8 + index * 6}}rpx"/></button></view><button class="tool-button" bindtap="onUndo" disabled="{{!canUndo}}">↶ 撤销</button><button class="tool-button" bindtap="onRedo" disabled="{{!canRedo}}">↷ 重做</button><button class="tool-button" bindtap="onClear">清空</button></view>
  <view class="draw-actions"><button class="primary" bindtap="onDone" loading="{{saving}}" disabled="{{saving}}">{{mode === 'duo' ? '我画好了，交给 TA 猜 ↗' : '画好了，存进画册 ↗'}}</button></view><view class="draw-subtitle">{{mode === 'duo' ? '下一步会隐藏餐品名称与参考图，再把手机交给对方。' : '保存后默认仅自己可见，你可以单独允许这张画公开。'}}</view>
</view>
<view wx:if="{{showSave}}" class="shade" bindtap="closeSave"><view class="sheet" catchtap="stop"><button class="sheet-close" bindtap="closeSave">×</button><view class="sheet-title">把今天，存进画册。</view><image class="save-preview" src="{{previewFile}}" mode="aspectFit"/><label class="sheet-label" for="artTitle">给这张画起个名字</label><input id="artTitle" class="title-input" maxlength="30" value="{{title}}" bindinput="onTitle"/><view class="consent-line"><switch class="consent-switch" color="#ce4335" checked="{{allowPublic}}" bindchange="onConsent"/><view>允许这张画在对应餐品旁公开展示<text class="consent-desc">仅关联「{{store.name}} · {{meal.name}}」。可随时撤回。原型仅在当前设备模拟。</text></view></view><button class="primary" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">保存到我的画册 ↗</button><view class="micro-note">不开启，就是仅自己可见。</view></view></view>
