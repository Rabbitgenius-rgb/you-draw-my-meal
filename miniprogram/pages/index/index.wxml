<view class="screen main-screen">
  <view class="wordmark">你画我点<text class="brand-star">✳</text></view>
  <block wx:if="{{tab === 'home'}}">
    <view class="store-row"><button class="store-button" bindtap="showStorePicker"><text class="pin">⌖</text>{{store.name}} ⌄</button><text class="demo-badge">{{menu.length ? '麦当劳菜单' : '等待选餐'}}</text></view>
    <view class="hero"><view class="eyebrow">TODAY’S MEAL, YOUR LITTLE ART.</view><view class="hero-title">把今天的好吃，<view><text class="highlight">画下来。</text></view></view><view class="hero-subtitle">一顿饭，一幅画，一点小快乐。</view><image class="hero-illustration" src="/assets/burger.png" mode="aspectFit"/><view class="hero-sticker">不用画得像，<view>画得开心就好。↗</view></view></view>
    <view class="section-heading"><text class="heading">今天，怎么画？</text><text class="aside">两种方式，一样好玩</text></view>
    <view class="modes"><button class="mode-card {{mode === 'solo' ? 'selected' : ''}}" data-mode="solo" bindtap="onMode"><text class="mode-icon">✎</text><text class="check">✓</text><text class="mode-name">一个人，慢慢画</text><text class="mode-desc">留住今天的一餐</text></button><button class="mode-card {{mode === 'duo' ? 'selected' : ''}}" data-mode="duo" bindtap="onMode"><text class="mode-icon">☻ ☻</text><text class="check">✓</text><text class="mode-name">两个人，猜着玩</text><text class="mode-desc">你来画，我来猜</text></button></view>
    <view class="section-heading"><text class="heading">选一道今天的餐品</text><text class="aside">给今天找个小主角</text></view>
    <view wx:if="{{!menu.length}}" class="connection-panel"><view class="connection-title">{{loading ? '正在加载麦当劳菜单…' : connected ? '选一家今天的餐厅' : '先连接麦当劳，开启今天的一画'}}</view><view>{{connectionMessage}}</view><view wx:if="{{!connected}}">请在电脑的本机网页预览中配置 Token。</view><button wx:if="{{connected}}" class="primary" bindtap="showStorePicker">搜索真实门店 ↗</button><button wx:else class="secondary" bindtap="connect" disabled="{{loading}}">重新检查连接</button></view><picker wx:if="{{menu.length}}" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategory"><view class="menu-picker">餐品分类 · {{categories[categoryIndex]}} ⌄</view></picker><view class="meal-grid"><button wx:for="{{visibleMenu}}" wx:key="id" class="meal-card {{selectedMeal === item.id ? 'selected' : ''}}" data-meal="{{item.id}}" bindtap="onMeal"><text class="check">✓</text><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFit" data-meal="{{item.id}}" binderror="onImageError"/><view wx:else class="image-placeholder">暂无参考图<view>可对照实物画</view></view><text class="meal-name">{{item.name}}</text><text class="meal-tag">{{item.tag}}</text></button></view>
    <button class="primary start-button" bindtap="onStart" disabled="{{!menu.length}}"><text>✎ {{mode === 'solo' ? '开始画今天的餐品' : '开始双人猜画'}}</text><text>↗</text></button><view class="micro-note">{{mode === 'solo' ? '画作默认只属于你，公开由你决定。' : '传手机双人玩法 · 画完后把手机交给对方。'}}</view>
    <button class="community-teaser" bindtap="onTab" data-tab="gallery"><view class="mini-art">✿</view><view><text class="community-title">看看大家笔下的这一餐</text><text class="community-desc">被允许公开的画，会在餐品旁遇见你。</text></view><text class="teaser-arrow">↗</text></button>
  </block>
  <block wx:elif="{{tab === 'gallery'}}">
    <view class="page-title">好吃，也好看。</view><view class="page-subtitle">同一道餐品，每个人都有自己的画法。</view><view class="store-row"><button class="store-button" bindtap="showStorePicker"><text class="pin">⌖</text>{{store.name}} ⌄</button><text class="demo-badge">{{menu.length ? '麦当劳菜单' : '等待选餐'}}</text></view>
    <view wx:if="{{!menu.length}}" class="info-strip">{{connectionMessage}}<button class="text-button" bindtap="connect" disabled="{{loading}}">重新检查连接</button></view><picker wx:if="{{menu.length}}" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategory"><view class="menu-picker">餐品分类 · {{categories[categoryIndex]}} ⌄</view></picker><view class="gallery-list"><view wx:for="{{visibleGallery}}" wx:key="id" class="gallery-card"><view class="gallery-product"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFit" data-meal="{{item.id}}" binderror="onImageError"/><view wx:else class="image-placeholder">暂无参考图<view>可对照实物画</view></view><view><text class="gallery-name">{{item.name}}</text><text class="gallery-count">{{item.count ? item.count + ' 张画作已获公开许可' : '等一张属于它的涂鸦'}}</text></view><button class="text-button" data-meal="{{item.id}}" bindtap="onStart">画这道 ↗</button></view><view class="gallery-art"><image wx:if="{{item.art}}" src="{{item.art.thumbnail}}" mode="aspectFit"/><view wx:else class="gallery-empty"><view class="empty-line">第一张，等你来画。</view><view>画作获准公开后，将出现在这里</view></view></view><view class="gallery-caption"><text>{{item.art ? item.art.title + ' · ' + item.date : '仅展示此门店、此餐品的获准画作'}}</text><button wx:if="{{item.art}}" class="text-button" data-meal="{{item.id}}" bindtap="onShuffle">↻ 换一幅</button></view></view></view><view class="info-strip">原型中的公开展示仅在当前设备模拟。你可以在「我的画册」随时撤回许可。</view>
  </block>
  <block wx:elif="{{tab === 'history'}}">
    <view class="mine-top"><view class="avatar">✎</view><view><view class="mine-title">我的小小画册</view><view class="mine-subtitle">把吃过的快乐，一笔一笔攒起来。</view></view></view><view class="stats"><view class="stat"><text class="stat-number">{{total}}</text><text class="stat-label">张小作品</text></view><view class="stat"><text class="stat-number">{{publicCount}}</text><text class="stat-label">张允许公开</text></view><view class="stat"><text class="stat-number">{{mealCount}}</text><text class="stat-label">种餐品记忆</text></view></view>
    <view class="filter-row"><button class="filter-chip {{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="onFilter">全部</button><button class="filter-chip {{filter === 'private' ? 'active' : ''}}" data-filter="private" bindtap="onFilter">仅自己</button><button class="filter-chip {{filter === 'public' ? 'active' : ''}}" data-filter="public" bindtap="onFilter">允许公开</button></view>
    <view wx:if="{{artworks.length}}" class="history-grid"><button wx:for="{{artworks}}" wx:key="id" class="history-card" data-id="{{item.id}}" bindtap="onDetail"><view class="art-paper"><image src="{{item.thumbnail}}" mode="aspectFit"/><text class="privacy {{item.isPublic ? 'public' : ''}}">{{item.isPublic ? '✳ 允许公开' : '⌑ 仅自己'}}</text></view><text class="history-title">{{item.title}}</text><text class="history-meta">{{item.date}} · {{item.modeLabel}}</text></button></view>
    <view wx:else class="empty-state"><image src="/assets/fries.png" mode="aspectFit"/><view class="empty-title">{{total ? '这一页，还没有作品' : '今天的快乐，还没落笔'}}</view><view class="empty-desc">{{total ? '换个分类看看你的其他画作。' : '不必是画家，也能拥有一本自己的餐品画册。'}}</view><button class="primary" bindtap="onTab" data-tab="home">去画今天这一餐 ↗</button></view><view class="version-note">作品保存在当前设备 · 重新打开后仍可查看<view>门店菜单来自麦当劳 MCP · 公开展示仅在本机模拟</view></view>
  </block>
</view>
<view class="tabbar"><button class="nav-item {{tab === 'home' ? 'active' : ''}}" data-tab="home" bindtap="onTab"><text class="nav-icon">✎</text><text>今天画</text></button><button class="nav-item {{tab === 'gallery' ? 'active' : ''}}" data-tab="gallery" bindtap="onTab"><text class="nav-icon">▧</text><text>餐品画廊</text></button><button class="nav-item {{tab === 'history' ? 'active' : ''}}" data-tab="history" bindtap="onTab"><text class="nav-icon">▤</text><text>我的画册</text></button></view>
<view wx:if="{{showStores}}" class="shade" bindtap="closeStorePicker"><view class="sheet" catchtap="stop"><button class="sheet-close" bindtap="closeStorePicker">×</button><view class="sheet-title">今天在哪一店？</view><view class="sheet-desc">按城市和附近地标查找，到店自取菜单随门店变化。</view><view class="sheet-label">城市</view><input class="title-input" value="{{city}}" bindinput="onCity" maxlength="40"/><view class="sheet-label">位置关键词</view><input class="title-input" value="{{keyword}}" bindinput="onKeyword" placeholder="例如：安福路、人民广场" maxlength="100"/><button class="primary" bindtap="searchStores" loading="{{storeBusy}}" disabled="{{storeBusy}}">搜索附近门店</button><view class="sheet-desc">{{storeError}}</view><button wx:for="{{stores}}" wx:key="id" class="store-option {{store.id === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="onStore" disabled="{{storeBusy}}"><text class="store-name">{{item.name}} {{store.id === item.id ? '✓' : ''}}</text><text class="store-desc">{{item.address || item.area}} · {{item.note}}</text></button></view></view>
<view wx:if="{{detail}}" class="shade" bindtap="closeDetail"><view class="sheet" catchtap="stop"><button class="sheet-close" bindtap="closeDetail">×</button><view class="sheet-title">{{detail.title}}</view><image class="detail-art" src="{{detail.thumbnail}}" mode="aspectFit"/><view class="detail-meta">{{detail.date}} · {{detail.storeName}} · {{detail.mealName}}</view><view class="sheet-desc">{{detail.isPublic ? '这张画已获你的公开许可，可在对应门店的餐品旁随机出现。' : '这张画仅自己可见。公开展示由你决定。'}}</view><button class="primary" bindtap="onPrivacy">{{detail.isPublic ? '撤回公开许可' : '允许这张画公开展示 ↗'}}</button><button class="secondary" bindtap="onPreview">查看画作图片</button><button class="danger-text" bindtap="onDelete">删除这张画</button></view></view>
